@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string c, string? a = null)
        => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
           && (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Course Register</title>
    <meta name="description" content="A minimal student course registration portal for managing enrollments, academic programs, and semester records." />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
        <div class="header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">M<span>.</span></span>
                <span class="brand-text">
                    <span class="brand-title">Course Register</span>
                    <span class="brand-sub">Marwadi University</span>
                </span>
            </a>

            <nav class="site-nav" aria-label="Primary">
                <a class="nav-link @(IsActive("Home", "Index") ? "is-active" : "")" asp-controller="Home" asp-action="Index">Overview</a>
                <a class="nav-link @(IsActive("Student", "Index") ? "is-active" : "")" asp-controller="Student" asp-action="Index">Directory</a>
                <a class="nav-link @(IsActive("Student", "Create") ? "is-active" : "")" asp-controller="Student" asp-action="Create">Register</a>
            </nav>

            <div class="header-meta">EST. 2025 &nbsp;/&nbsp; VOL. 01</div>
        </div>
    </header>

    <div class="page-shell">
        <main id="main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-left">
                <span class="footer-mark" aria-hidden="true">M.</span>
                <span>Department of Computer Engineering &middot; Marwadi University</span>
            </div>
            <div class="footer-right">
                <span>.NET Technologies (01CE1523) &middot; ASP.NET Core MVC</span>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
