@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-head" data-reveal>
    <div>
        <div class="page-kicker">Course Register / Error</div>
        <h1 class="page-title">Something went wrong.</h1>
        <p class="page-sub">The request could not be completed. You can return to the overview and try again.</p>
    </div>
</div>

<div class="prose" data-reveal>
    <div class="error-mark" aria-hidden="true">!</div>

    @if (Model.ShowRequestId)
    {
        <p>
            Reference for this request: <code>@Model.RequestId</code>
        </p>
    }

    <h2>Development mode</h2>
    <p>
        Running in the <strong>Development</strong> environment shows more detail about failures.
        Set the <code>ASPNETCORE_ENVIRONMENT</code> variable to <code>Development</code> and restart
        the application to see that detail locally.
    </p>

    <p style="margin-top: 36px;">
        <a class="btn btn-outline" asp-controller="Home" asp-action="Index">&larr; Back to overview</a>
    </p>
</div>
